<config xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xmlns='http://www.ehcache.org/v3'
        xsi:schemaLocation='http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd'>

    <!-- Région de cache pour l'entité Auteur -->
    <cache alias="com.bibliotheque.model.Auteur">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Région de cache pour la collection de livres associée à un Auteur -->
    <cache alias="com.bibliotheque.model.Auteur.livres">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">2000</heap>
        </resources>
    </cache>

    <!-- Région de cache pour l'entité Livre -->
    <cache alias="com.bibliotheque.model.Livre">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">5000</heap>
        </resources>
    </cache>

    <!-- Région standard Hibernate pour les résultats de requêtes (Query Cache) -->
    <cache alias="default-query-results-region">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Région standard Hibernate pour le suivi des timestamps d'invalidation -->
    <cache alias="default-update-timestamps-region">
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

</config>
